# macOS
.DS_Store

# Workspace-local envs and caches
.env
.env.*
!.env.example
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.idea/
.vscode/

# Top-level office and paper artifacts
/*.pdf
/*.doc
/*.docx
/*.ppt
/*.pptx
!De cuong LVThS - *

# Logs and temp artifacts
*.log
tmp/
temp/

# Build outputs and caches
/dist/
dist/
*.tsbuildinfo
/output/
/coverage/
/.turbo/

# Scan/eval outputs (generated) anywhere in the tree
**/results/

# Benchmark archives + ingested corpora (regenerate via scripts/juliet/ingest.ts)
/juliet.zip
*.zip
/demo/juliet_cwe401/

# LAMeD benchmark corpus: regenerable via scripts/lamed/ingest.ts; only the
# committed source (memleak_benchmark.json + cJSON-annotated.csv) is tracked.
/demo/lamed/cases/
/demo/lamed/.clones/
/demo/lamed/corpus_manifest.json

# MemHint-derived corpus: regenerable via scripts/memhint/ingest.ts; only the
# committed source (memhint_bugs.json — the independently-reconstructed
# ground truth) is tracked.
/demo/memhint/cases/
/demo/memhint/.clones/
/demo/memhint/corpus_manifest.json
/demo/memhint/corpus_validation_report.json
/demo/memhint/corpus_validation_report.md

/demo/**/a.out

# User-provided scan targets
/targets/*
!/targets/.gitkeep

# Generated demo corpus build artifacts
/demo/**/compilation.json
/demo/**/compile_commands.json
/demo/**/build/
/demo/**/simple_leak
/demo/**/simple_leak_asan

.antigravitycli

vendor

# corpus validation reports (regenerable; the lockfile is the committed artifact)
demo/**/corpus_validation_report.json
demo/**/corpus_validation_report.md

.omo

# evaluation/ CLI's own scratch cache (unzip staging for the Juliet auto-ingest sub-flow)
/evaluation/.cache/

# ad hoc smoke-test corpora created while exercising evaluation/cli.ts's ingest flow
/demo/*-smoke-test/
/demo/*-smoke-test.lock.json
