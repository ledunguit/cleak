  },
  "dependencies": {
    "@cleak/common": "workspace:*",
    "pino": "^9.5.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
