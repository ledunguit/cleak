{
  "name": "static-analyzer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "cd ../.. && nest build static-analyzer",
    "dev": "cd ../.. && nest start static-analyzer --watch",
    "start": "cd ../.. && nest start static-analyzer",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@cleak/common": "workspace:*",
    "@cleak/observability": "workspace:*",
    "dotenv": "^16.4.7"
  }
}
